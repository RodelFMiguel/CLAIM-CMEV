# The vision worker image: cmev-worker-parts (M1 only) and cmev-worker-image (M1, M2 and M3).
# Specifications: docs/specs/module-01-vehicle-part-segmentation.md, module-02-damage-segmentation.md,
#                 module-03-part-summary-coverage.md
#
# Opt-in: a worker is added to the stack by infra/compose/docker-compose.parts.yml or
# docker-compose.image.yml, which also switch every service together. The image holds no
# weights: the model registry is mounted read-only at CMEV_MODEL_REGISTRY_PATH and a worker
# refuses to start unless each entry it serves (configs/models/parts.yaml, and damage.yaml for
# the image role) is there and matches its manifest.
#
# This is the only image with the model libraries (the `vision` extra: PyTorch, transformers).
# The package is installed non-editable, so the configuration these roles read is located
# through CMEV_* variables: the two model files, the M2 assignment and M3 summary rules, the
# taxonomy and the M9 overlay style. No role here reads the M8 rules.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    CMEV_TAXONOMY_DIR=/srv/configs/taxonomy \
    CMEV_PARTS_CONFIG=/srv/configs/models/parts.yaml \
    CMEV_DAMAGE_CONFIG=/srv/configs/models/damage.yaml \
    CMEV_M2_CONFIG=/srv/configs/pipeline/m2_assignment.yaml \
    CMEV_M3_CONFIG=/srv/configs/pipeline/m3_summary.yaml \
    CMEV_M9_REVIEW_CONFIG=/srv/configs/pipeline/m9_review.yaml \
    CMEV_MODEL_REGISTRY_PATH=/srv/artifacts/models \
    CMEV_WORKER_ROLE=parts
WORKDIR /srv
COPY pyproject.toml README.md ./
COPY src/claim_cmev ./src/claim_cmev
COPY configs ./configs
RUN pip install ".[vision]" && useradd --uid 10001 --create-home cmev \
    && mkdir -p /srv/artifacts/models
USER 10001:10001
CMD ["python", "-m", "claim_cmev.worker", "run", "--role", "parts"]
