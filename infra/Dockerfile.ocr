# PaddleOCR CPU service. Weights are provisioned offline and mounted read-only.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    CMEV_WORKER_ROLE=ocr \
    CMEV_MIGRATIONS_DIR=/srv/infra/migrations \
    CMEV_MODEL_REGISTRY_PATH=/srv/artifacts/models \
    CMEV_OCR_MODEL_CONFIG=/srv/configs/models/ocr.yaml \
    CMEV_OCR_MANIFEST=/srv/configs/models/ocr-manifest.json \
    CMEV_M4_CONFIG=/srv/configs/pipeline/m4_page_reading.yaml
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY src/claim_cmev ./src/claim_cmev
COPY configs ./configs
COPY infra/migrations ./infra/migrations
COPY infra/requirements-ocr.txt ./requirements-ocr.txt
RUN pip install -c requirements-ocr.txt . -r requirements-ocr.txt \
    && useradd --uid 10001 --create-home cmev && mkdir -p /srv/artifacts/models
USER 10001:10001
CMD ["python", "-m", "claim_cmev.worker", "run", "--role", "ocr"]
