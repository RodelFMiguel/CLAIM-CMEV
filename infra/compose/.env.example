# Copy to .env in this directory. These values are local demonstration placeholders.
CMEV_WEB_PORT=8080
CMEV_DB_PASSWORD=replace-with-local-db-password
CMEV_OBJECT_STORE_ACCESS_KEY=cmev-local
CMEV_OBJECT_STORE_SECRET_KEY=replace-with-local-object-secret
CMEV_DEMO_EMAIL=surveyor@claim-cmev.demo
CMEV_DEMO_PASSWORD=Demo2026!

# Real M1 parts worker: add `-f infra/compose/docker-compose.parts.yml` to the Compose command.
# Nothing here switches it on. This only moves the model registry, the host folder that holds
# parts/<version>/ and is mounted read-only into the worker.
# CMEV_MODEL_REGISTRY_HOST_PATH=../../artifacts/models
