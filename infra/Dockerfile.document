# Neural M5/M6 runtime; PaddleOCR remains in its separate CPU image.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    CMEV_TAXONOMY_DIR=/srv/configs/taxonomy \
    CMEV_MIGRATIONS_DIR=/srv/infra/migrations \
    CMEV_MODEL_REGISTRY_PATH=/srv/artifacts/models \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /srv
COPY infra/requirements-document.txt ./requirements-document.txt
RUN pip install -r requirements-document.txt
COPY pyproject.toml README.md ./
COPY src/claim_cmev ./src/claim_cmev
COPY configs ./configs
COPY infra/migrations ./infra/migrations
RUN pip install -c requirements-document.txt ".[document-worker]" \
    && useradd --uid 10001 --create-home cmev && mkdir -p /srv/artifacts/models
USER 10001:10001
CMD ["python", "-m", "claim_cmev.worker", "run", "--role", "document"]
