{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claim-cmev.local/contracts/events/cmev.cmd.damage-segment.v1.schema.json",
  "title": "cmev.cmd.damage-segment.v1",
  "description": "Segment damage on one photo and assign parts. Integration contracts section 5.4.",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.v1.schema.json"
    },
    {
      "properties": {
        "versions": {
          "properties": {
            "taxonomy": {
              "$ref": "envelope.v1.schema.json#/$defs/damageTaxonomy"
            }
          },
          "required": [
            "taxonomy"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "versions": {
            "properties": {
              "taxonomy": {
                "pattern": "^damage-cardd-"
              }
            },
            "required": [
              "taxonomy"
            ]
          }
        },
        "required": [
          "versions"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "taxonomy_version": {
                "pattern": "^damage-cardd-"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "versions": {
            "properties": {
              "taxonomy": {
                "pattern": "^damage-hitl-"
              }
            },
            "required": [
              "taxonomy"
            ]
          }
        },
        "required": [
          "versions"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "taxonomy_version": {
                "pattern": "^damage-hitl-"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "payload"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "photo": {
          "$ref": "envelope.v1.schema.json#/$defs/fileRef"
        },
        "part_mask_ref": {
          "$ref": "envelope.v1.schema.json#/$defs/maskRef"
        },
        "transform": {
          "$ref": "envelope.v1.schema.json#/$defs/imageTransform"
        },
        "model_id": {
          "$ref": "envelope.v1.schema.json#/$defs/identifier"
        },
        "model_version": {
          "$ref": "envelope.v1.schema.json#/$defs/version"
        },
        "preprocess_config_version": {
          "$ref": "envelope.v1.schema.json#/$defs/version"
        },
        "assignment_config_version": {
          "$ref": "envelope.v1.schema.json#/$defs/version"
        },
        "taxonomy_version": {
          "$ref": "envelope.v1.schema.json#/$defs/damageTaxonomy"
        },
        "accepted_parts": {
          "description": "The part codes M1 accepted on this photograph. Copied forward from the parts job so M2 does not query the database for them.",
          "type": "array",
          "items": {
            "$ref": "envelope.v1.schema.json#/$defs/partCode"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "photo",
        "part_mask_ref",
        "transform",
        "model_id",
        "model_version",
        "preprocess_config_version",
        "assignment_config_version",
        "taxonomy_version"
      ],
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
